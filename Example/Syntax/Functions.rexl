f/s/newline/
  o/.*/
/ms
/

f/s/op1/
  o/.*/Operation 1./ms
  f/c/newline/
/

f/s/op2/
  o/.*/Operation 2./ms
  f/c/newline/
/

f/s/op3/
  o/.*/Operation 3./ms
  f/c/newline/
/

o/.*/Call Result: /ms
f/c/newline/
f/c/newline/
f/c/op1/
f/c/op2/
f/c/op3/

w/op/.*/op1/ms
f/c/@op/

w/op/.*/op3/ms
f/c/@op/

# remove newline function
f/u/newline/
f/c/newline/